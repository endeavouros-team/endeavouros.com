---
import '../styles/themes.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; ogType?: 'website' | 'article' }
const site = await siteData();
const {
  title = `${site.name} — ${site.description}`,
  description = site.description,
  image,
  ogType = 'website',
} = Astro.props;

// Unset by default, so every local and preview build is noindex. Only the release
// workflow (.github/workflows/build.yml) sets it, which is what keeps a hand-built
// copy from ever being indexed by accident.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Absolute, because og:image is read by crawlers that have no page context.
// Without one a shared announcement previews as an empty card.
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} News`} href="/news/feed.xml" />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {/* Must run before first paint or the theme flashes. With no stored choice it
      sets nothing and CSS resolves the OS preference on its own. */}
  <script is:inline>
    // The collapsible nav must be marked here, not from a bundled module: those
    // are deferred and can paint first, which would flash the eight-item nav
    // wrapped over four lines before it collapsed. With scripting off the class
    // is never set, the hamburger stays hidden and the nav wraps as it always
    // has -- degraded, but never a control that cannot work.
    document.documentElement.classList.add("js");
    try {
      var t = localStorage.getItem("eos-theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
