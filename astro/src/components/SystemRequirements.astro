---
import { release } from '../lib/site';
const rel = await release();
const r = rel.requirements;
---
<section class="section section--sunken" id="requirements">
  <div class="container stack">
    <h2>System requirements</h2>
    <div class="grid">
      <div class="card stat"><p class="stat__value">{r.diskGb} GB</p><p class="stat__label">free disk space</p></div>
      <div class="card stat"><p class="stat__value">{r.ramGb} GB</p><p class="stat__label">RAM</p></div>
      <div class="card stat"><p class="stat__value">64-bit</p><p class="stat__label">{r.cpu}</p></div>
    </div>
    <p class="lede">{r.note}</p>
  </div>
</section>
