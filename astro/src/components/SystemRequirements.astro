---
import { release } from '../lib/site';
const rel = await release();
const req = rel.requirements;
const rec = req.recommended;
---
<section class="section section--sunken" id="requirements">
  <div class="container stack">
    <h2>System requirements</h2>
    <p class="lede">Minimum</p>
    <div class="grid">
      <div class="card stat"><p class="stat__value">{req.diskGb} GB</p><p class="stat__label">free disk space</p></div>
      <div class="card stat"><p class="stat__value">{req.ramGb} GB</p><p class="stat__label">RAM</p></div>
      <div class="card stat"><p class="stat__value">64-bit</p><p class="stat__label">{req.cpu}</p></div>
    </div>
    <p class="lede">Recommended</p>
    <div class="grid">
      <div class="card stat"><p class="stat__value">{rec.diskGb} GB</p><p class="stat__label">free disk space</p></div>
      <div class="card stat"><p class="stat__value">{rec.ramGb} GB</p><p class="stat__label">RAM</p></div>
      <div class="card stat"><p class="stat__value">64-bit</p><p class="stat__label">{rec.cpu}</p></div>
    </div>
    <p class="lede">{req.note}</p>
  </div>
</section>
