---
import { release, siteData } from '../lib/site';
// The mark rather than the full lockup: the header already carries the
// wordmark, and a 3.8:1 lockup does not sit beside a block of text.
import Mark from '../../../brand/mark.svg';
const rel = await release();
const site = await siteData();
// One button. The magnet and torrent links, the ISO line and the note about
// torrent clients stood here too until 2026-09-20; they are on /download/ now,
// with the mirrors and the checksums, which is where a reader choosing how to
// download is. Joe and Bryan asked for the single button once the download
// page existed on its own.
---
<section class="hero">
  <div class="container hero__inner">
    <Mark class="hero__mark" role="presentation" aria-hidden="true" />
    <div class="hero__text">
    <h1>{site.tagline}</h1>
    <p class="hero__sub">{site.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/download/">Download {rel.codename}</a>
    </div>
    </div>
  </div>
</section>
