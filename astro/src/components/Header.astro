---
import ThemeToggle from './ThemeToggle.astro';
// Astro inlines an imported SVG as a component, which is what the lockup needs:
// its wordmark path is currentColor, and that does not cross into an <img>.
import Logo from '../../../brand/logo-horizontal.svg';
import { siteData } from '../lib/site';
const site = await siteData();
const here = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <Logo class="brand__logo" role="img" aria-label={site.name} />
    </a>
    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {site.nav.map((item) => (
          <li>
            <a
              class:list={['nav__link', { 'nav__link--cta': item.cta, 'nav__link--wip': item.wip }]}
              href={item.url}
              rel={item.external ? 'noopener noreferrer' : undefined}
              title={item.wip ? 'Not migrated yet — opens the current site' : undefined}
              aria-current={!item.external && here === item.url ? 'page' : undefined}
            >{item.name}</a>
          </li>
        ))}
        <li><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>
