---
import Base from '../layouts/Base.astro';
import MirrorList from '../components/MirrorList.astro';
import VerifyInstructions from '../components/VerifyInstructions.astro';
import { siteData } from '../lib/site';
const site = await siteData();
---
<Base title={`Download — ${site.name}`} description="Download EndeavourOS from a mirror near you, and verify it.">
  <section class="section">
    <div class="container stack">
      <h1>Download EndeavourOS</h1>
      <p class="lede">
        Pick a mirror near you, then verify what you downloaded against the checksum and the
        GPG signature below.
      </p>
    </div>
  </section>
  <MirrorList />
  <VerifyInstructions />
</Base>
